# Configuração de INFRA/DEPLOY do Hostspost (fica no servidor, NUNCA na UI).
# Copie para deploy/.env e preencha. NÃO versione o .env real (já está no .gitignore).

# Domínio que aponta para a VPS (Caddy emite o certificado HTTPS automaticamente)
DOMAIN=portal.seuhospital.com.br

# Token de administrador do backend (rotas de blacklist). Gere um valor forte:
#   openssl rand -hex 24
ADMIN_TOKEN=troque-por-um-token-forte

# Limite de dispositivos por CPF
DEVICE_LIMIT=2

# --- Banco FreeRADIUS (produção). Deixe em branco para rodar em memória (sem persistir). ---
# Aponte para o MySQL/MariaDB do FreeRADIUS (mesmo schema de docs/03).
DB_HOST=
DB_PORT=3306
DB_USER=radius
DB_PASS=
DB_NAME=radius
